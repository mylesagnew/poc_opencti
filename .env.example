# Reference only. You do not need to create this file.
#
# opencti-install.sh generates ~/opencti-deployment/.env itself, with random
# 20-character secrets and a fresh connector UUID, and sets it to chmod 600.
# This file documents the variables that the generated docker-compose.yml expects.

# MinIO (object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMePlease!

# RabbitMQ (message queue)
RABBITMQ_DEFAULT_USER=rabbitmquser
RABBITMQ_DEFAULT_PASS=ChangeMePlease!

# OpenCTI admin
OPENCTI_ADMIN_EMAIL=admin@opencti.local
OPENCTI_ADMIN_PASSWORD=ChangeMePlease!
OPENCTI_ADMIN_TOKEN=ChangeMePlease!
OPENCTI_SESSION_SECRET=ChangeMePlease!

# SMTP (optional)
SMTP_HOSTNAME=localhost

# Connector IDs (one UUIDv4 each)
CONNECTOR_EXPORT_FILE_STIX_ID=00000000-0000-4000-8000-000000000000
